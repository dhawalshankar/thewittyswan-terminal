# deploy/TODO_SERVICE_NAME.service
[Unit]
Description=thewittyswan terminal service
After=network.target

[Service]
Type=simple
User=TODO_FILL_DEPLOY_USER
WorkingDirectory=TODO_FILL_APP_DIR
ExecStart=TODO_FILL_APP_DIR/TODO_FILL_BINARY_NAME
Restart=always
RestartSec=3
EnvironmentFile=TODO_FILL_APP_DIR/.env
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
